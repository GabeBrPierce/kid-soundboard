{
  "version": "1.1.2",
  "name": "Kid Soundboard",
  "description": "Fun sound effects for kids. Press 0-9 to play, left/right to change page.",
  "type": "web",
  "launch_path": "/kid-soundboard/index.html",
  "icons": {
    "56": "/kid-soundboard/icons/icon-56x56.png",
    "112": "/kid-soundboard/icons/icon-112x112.png",
    "224": "/kid-soundboard/icons/icon-224x224.png"
  },
  "developer": {
    "name": "GabeBrPierce",
    "url": "https://github.com/GabeBrPierce"
  },
  "permissions": {
    "serviceworker": {}
  },
  "cursor": "false",
  "locales": {
    "en-US": {
      "name": "Kid Soundboard",
      "subtitle": "Sound effects for kids",
      "description": "Press 0-9 to play sounds, left/right to change page."
    }
  },
  "default_locale": "en-US"
}
